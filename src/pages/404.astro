---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeoButton from '../components/atoms/NeoButton.astro';

export const prerender = true;
---

<BaseLayout title="Página não encontrada - Instituto Hub">
	<main class="container mx-auto px-4 py-16 md:py-32 max-w-4xl flex flex-col items-center justify-center text-center gap-8 relative z-10 min-h-[60vh]">
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-destaque rounded-full blur-[100px] -z-10 opacity-50 animate-pulse pointer-events-none"></div>

        <div class="relative group">
            <h1 class="text-[8rem] sm:text-[12rem] md:text-[16rem] font-heading font-black text-principal leading-none tracking-tighter mix-blend-multiply group-hover:-rotate-3 group-hover:scale-105 transition-transform duration-500">
                404
            </h1>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl sm:text-7xl md:text-8xl group-hover:rotate-12 transition-transform duration-500 z-10">
                🧭
            </div>
        </div>

        <div class="bg-white border-4 border-principal neo-shadow p-6 md:p-10 transform rotate-1 hover:rotate-0 transition-transform w-full max-w-2xl rounded-2xl z-20">
            <h2 class="text-2xl sm:text-4xl font-heading font-black text-principal uppercase mb-4">Eita, nos perdemos!</h2>
            <p class="text-base sm:text-lg text-slate-700 font-bold mb-8">
                Parece que a página que você está procurando não existe ou foi movida. Mas não se preocupe, o caminho de volta é seguro.
            </p>
            
            <NeoButton href="/" variant="primary" size="lg" class="py-4 h-auto text-lg sm:text-xl font-black px-8 rounded-xl w-full sm:w-auto inline-flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Voltar para a Home
            </NeoButton>
        </div>
	</main>
</BaseLayout>
