---
import BaseLayout from '../layouts/BaseLayout.astro';
import AulaCard from '../components/molecules/AulaCard.astro';
import { fetchAulas, fetchSiteSettings, urlFor, daysOfWeek } from '../utils/sanity';
import HeroBanner from '../components/molecules/HeroBanner.astro';
import EmptyState from '../components/molecules/EmptyState.astro';
import type { Aula } from '../types';

// Configuração de Cache no Edge (Netlify ISR magico)
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, s-maxage=60, stale-while-revalidate=31536000');

const { aulas, activeDayId } = await fetchAulas();
const siteSettings = await fetchSiteSettings();
---

<BaseLayout title="Aulas - Instituto Hub">

		<main class="container mx-auto px-4 py-8 md:py-16 max-w-7xl flex flex-col gap-12 sm:gap-16 relative z-10">
            
            <HeroBanner
              emoji="📚"
              titleLine1="Aulas"
              titleLine2="Ministradas"
              subtitle="Conheça a grade curricular deste semestre e inscreva-se nas classes do Instituto de Religião."
              class="max-w-4xl mx-auto mb-4 sm:mb-8"
            />

            
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-3 sm:gap-4 mt-4 sm:mt-6 justify-center animate-slide-up z-20 relative w-full max-w-[340px] sm:max-w-none mx-auto sm:px-2">
                {daysOfWeek.map(day => (
                    <button 
                        class={`tab-btn btn hover:border-principal border-4 border-principal  uppercase font-black tracking-widest sm:tracking-wider text-sm sm:text-base py-0 min-h-0 h-12 sm:h-14 transition-all w-full sm:w-auto sm:px-8 ${
                            day.id === activeDayId 
                            ? 'bg-destaque hover:bg-destaque text-principal neo-shadow translate-y-0' 
                            : 'bg-white hover:bg-slate-100 text-principal translate-y-1 hover:translate-y-0 hover:neo-shadow'
                        }`} 
                        data-target={`tab-${day.id}`}
                    >
                        {day.label}
                    </button>
                ))}
            </div>

            
            <div class="animate-slide-up delay-100 mt-4 sm:mt-6 min-h-[40vh] relative z-10 w-full mb-12">
                
                {daysOfWeek.map(day => {
                    const aulasDia = aulas.filter((a: Aula) => a.weekday === day.id);
                    return (
                        <section id={`tab-${day.id}`} class={`tab-content ${day.id === activeDayId ? 'grid' : 'hidden'} grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 max-w-6xl mx-auto`}>
                            {aulasDia.length > 0 ? (
                                aulasDia.map((aula: Aula, index: number) => (
                                    <AulaCard 
                                        courseType={aula.courseType}
                                        modality={aula.modality}
                                        title={aula.title}
                                        instructor={aula.instructor}
                                        time={aula.time || ''}
                                        description={aula.description}
                                        imageSrc={aula.image ? urlFor(aula.image).width(800).height(600).url() : 'https://images.unsplash.com/photo-1491841550275-ad7854e35ca6?q=80&w=1000&auto=format&fit=crop'}
                                        imageAlt={aula.title}
                                        tagRotateClass={index % 2 === 0 ? '-rotate-3' : 'rotate-2'}
                                        theme={aula.courseType === 'Fundamental' ? 'fundamental' : 'eletivo'}
                                        whatsAppUrl={aula.whatsAppUrl}
                                        zoomUrl={aula.zoomUrl}
                                        enrollmentUrl={siteSettings?.enrollmentUrl}
                                        recoveryUrl={siteSettings?.recoveryUrl}
                                    />
                                ))
                            ) : (
                                <EmptyState
                                  emoji="⏳"
                                  title="Sem Aulas Neste Dia"
                                  description="Nenhuma turma foi alocada para este dia da semana no momento."
                                  class="col-span-full"
                                />
                            )}
                        </section>
                    )
                })}

            </div>
		</main>

        
        <script>
            document.addEventListener('astro:page-load', () => {
                const tabBtns = document.querySelectorAll('.tab-btn');
                const tabContents = document.querySelectorAll('.tab-content');

                tabBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const targetId = btn.getAttribute('data-target');

                        // Oculta todas as sections / Mostra a Section alvo
                        tabContents.forEach(content => {
                            if (content.id === targetId) {
                                content.classList.remove('hidden');
                                content.classList.add('grid');
                            } else {
                                content.classList.add('hidden');
                                content.classList.remove('grid');
                            }
                        });

                        // Reseta o estilo dos botões inativos e Ilumina a aba ativa
                        tabBtns.forEach(b => {
                            if (b === btn) {
                                b.classList.add('bg-destaque', 'hover:bg-destaque', 'neo-shadow', 'translate-y-0');
                                b.classList.remove('bg-white', 'hover:bg-slate-100', 'translate-y-1', 'hover:translate-y-0', 'hover:neo-shadow');
                            } else {
                                b.classList.add('bg-white', 'hover:bg-slate-100', 'translate-y-1', 'hover:translate-y-0', 'hover:neo-shadow');
                                b.classList.remove('bg-destaque', 'hover:bg-destaque', 'neo-shadow', 'translate-y-0');
                            }
                        });
                    });
                });
            });
        </script>

        
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ItemList",
          "itemListElement": aulas.map((aula, idx) => ({
            "@type": "ListItem",
            "position": idx + 1,
            "item": {
              "@type": "Course",
              "name": aula.title,
              "description": aula.description,
              "provider": {
                "@type": "Organization",
                "name": "Instituto de Religião de Porto Alegre",
                "sameAs": "https://instituto-hub.netlify.app"
              }
            }
          }))
        })} />
</BaseLayout>
