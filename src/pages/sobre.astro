---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Sobre - Instituto Hub">
    <main class="container mx-auto px-4 py-8 md:py-16 max-w-6xl flex flex-col gap-12 sm:gap-20 relative z-10">
        
        <!-- Seção Nossa História -->
        <section class="bg-principal text-white p-6 sm:p-8 md:p-10 animate-slide-up w-full relative">
            <div class="absolute -top-4 -left-4 sm:-top-6 sm:-left-6 w-12 h-12 sm:w-16 sm:h-16 bg-destaque border-4 border-principal rounded-full z-20 flex items-center justify-center text-2xl sm:text-3xl neo-shadow transform -rotate-12">
                🏛️
            </div>

            <!-- Layout 3 Colunas: Texto | Carrossel de Diretores | Foto do Local -->
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start w-full relative z-10 pt-4">
                
                <!-- Coluna 1: Título + Texto -->
                <div class="w-full lg:w-[30%] shrink-0 flex flex-col pt-0 lg:pt-2">
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-black uppercase leading-[0.9] tracking-tighter mb-8">
                        Nossa<br/>
                        <span class="text-destaque" style="-webkit-text-stroke: 1px var(--color-principal);">História</span>
                    </h1>
                    <p class="text-base sm:text-lg font-bold border-l-4 border-destaque pl-4 leading-relaxed opacity-90">
                        Conheça o Instituto de Religião de Porto Alegre e descubra por que milhares de jovens adultos se reúnem aqui.
                    </p>
                </div>

                <!-- Coluna 2: Carrossel de Diretores -->
                <div class="w-full lg:w-[26%] shrink-0 relative flex flex-col items-center mx-auto lg:mx-0 mt-6 lg:mt-0">
                    <!-- Badge -->
                    <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-destaque text-principal font-heading font-black uppercase text-xs sm:text-sm tracking-widest px-4 py-1.5 border-2 border-black shadow-[2px_2px_0_0_black] -rotate-2 w-max z-30 pointer-events-none">
                        Nossos Diretores
                    </div>

                    <!-- Carrossel + Botões (em linha) -->
                    <div class="relative flex items-center justify-center pt-10 w-full gap-2">
                        <!-- Botão Anterior -->
                        <button id="btn-prev-diretor" aria-label="Diretor Anterior" class="shrink-0 z-30 bg-transparent text-destaque p-1.5 transition-transform hover:scale-110 active:scale-95 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        </button>

                        <!-- Container (1 slide visível) -->
                        <div id="carousel-diretores" class="w-[200px] flex overflow-hidden snap-x snap-mandatory scroll-smooth shrink-0">
                            <!-- Slide 1 -->
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-yellow-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=300&auto=format&fit=crop" alt="Diretor" class="w-full h-full object-cover grayscale-[0.3]" />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Sérgio O.</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2010 - 2015</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Slide 2 -->
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform -rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-pink-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-[#25D366] mb-2">
                                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=300&auto=format&fit=crop" alt="Diretora" class="w-full h-full object-cover grayscale-[0.3]" />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Maria E.</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2015 - 2020</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Slide 3 -->
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-2 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-blue-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-principal mb-2">
                                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=300&auto=format&fit=crop" alt="Diretor" class="w-full h-full object-cover grayscale-[0.3]" />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Carlos M.</p>
                                        <span class="bg-destaque text-principal px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2020 - Atual</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botão Próximo -->
                        <button id="btn-next-diretor" aria-label="Próximo Diretor" class="shrink-0 z-30 bg-transparent text-destaque p-1.5 transition-transform hover:scale-110 active:scale-95 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const carousel = document.getElementById('carousel-diretores');
                            const btnPrev = document.getElementById('btn-prev-diretor');
                            const btnNext = document.getElementById('btn-next-diretor');
                            if (carousel && btnPrev && btnNext) {
                                const update = () => {
                                    const max = carousel.scrollWidth - carousel.clientWidth;
                                    btnPrev.style.visibility = carousel.scrollLeft <= 5 ? 'hidden' : 'visible';
                                    btnNext.style.visibility = carousel.scrollLeft >= max - 5 ? 'hidden' : 'visible';
                                };
                                btnNext.addEventListener('click', () => carousel.scrollBy({ left: carousel.clientWidth, behavior: 'smooth' }));
                                btnPrev.addEventListener('click', () => carousel.scrollBy({ left: -carousel.clientWidth, behavior: 'smooth' }));
                                carousel.addEventListener('scroll', update);
                                setTimeout(update, 100);
                            }
                        });
                    </script>
                </div>

                <!-- Coluna 3: Foto do Local -->
                <div class="w-full lg:flex-1 flex justify-center lg:justify-end mt-10 lg:mt-0">
                    <div class="bg-white p-3 pb-16 sm:p-4 sm:pb-20 transform rotate-2 w-full max-w-[380px] sm:max-w-[440px] group relative text-principal outline outline-[1.5px] outline-transparent ring-1 ring-transparent">
                        <!-- Fita adesiva -->
                        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-20 h-8 bg-yellow-100 opacity-90 transform -rotate-3 z-10 pointer-events-none shadow-sm drop-shadow-sm"></div>
                        <!-- Imagem 4/3 -->
                        <div class="w-full aspect-[4/3] overflow-hidden bg-slate-200 mb-2">
                            <img src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?q=80&w=800&auto=format&fit=crop" alt="Foto histórica do Instituto" class="w-full h-full object-cover grayscale-[0.8] contrast-125" />
                        </div>
                        <div class="absolute bottom-5 sm:bottom-6 w-full left-0 text-center px-4 flex flex-col items-center">
                            <p class="font-heading font-black text-principal text-lg sm:text-xl uppercase tracking-wider">O Início</p>
                            <p class="font-bold text-slate-500 text-[0.65rem] sm:text-xs mt-0.5 uppercase tracking-wide">A Sede Oficial do Instituto</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Propósito e Missão Section (Grid Esquerda/Direita) -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 animate-slide-up delay-100">
            <!-- Left Card -->
            <div class="bg-white border-4 border-principal p-6 sm:p-10 flex flex-col justify-center transform -rotate-1">
                <h2 class="text-3xl sm:text-5xl font-heading font-black text-principal uppercase leading-[1] mb-6 border-b-4 border-destaque inline-block w-max pb-2">
                    Qual o<br/>Nosso Propósito?
                </h2>
                <p class="text-base sm:text-lg font-bold text-slate-600 mb-4 leading-relaxed">
                    O Instituto de Religião é muito mais do que um prédio ou uma sala de aula. É um <strong class="text-principal">refúgio espiritual</strong> projetado especificamente para jovens adultos solteiros e casados (de 18 a 35 anos).
                </p>
                <p class="text-base sm:text-lg font-bold text-slate-600 leading-relaxed">
                    Nosso objetivo é ajudar você a compreender e confiar nos ensinamentos e na Expiação de Jesus Cristo, a se qualificar para as bênçãos do templo e a preparar a si mesmo, sua família e outras pessoas para a vida eterna.
                </p>
            </div>
            
            <!-- Right Card (Image) -->
            <div class="bg-destaque border-4 border-principal neo-shadow overflow-hidden transform rotate-1 hover:-rotate-1 transition-transform h-[300px] sm:h-[400px] lg:h-auto group">
                <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?q=80&w=1000&auto=format&fit=crop" alt="Grupo de jovens no instituto reunidos e sorrindo" class="w-full h-full object-cover grayscale-[0.3] contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500" />
            </div>
        </section>

        <!-- Big Brutalist Quote -->
        <section class="bg-slate-800 text-white border-4 border-principal neo-shadow p-8 sm:p-12 md:p-16 animate-slide-up delay-200 w-full relative overflow-hidden">
            <div class="absolute -top-10 -right-10 text-[10rem] sm:text-[15rem] text-destaque font-black opacity-10 leading-none pointer-events-none">
                "
            </div>
            <p class="text-2xl sm:text-4xl md:text-5xl font-black font-heading leading-tight max-w-4xl relative z-10 hover:text-destaque transition-colors">
                O Instituto é o baluarte espiritual que todo jovem adulto precisa para não se perder nas névoas de escuridão do mundo moderno.
            </p>
            <div class="mt-8 bg-principal text-destaque uppercase tracking-widest font-black text-xs sm:text-sm relative z-10 w-max px-6 py-4 flex items-center justify-center leading-none">
                A liderança local
            </div>
        </section>

        <!-- Estrutura e Destaques (3 Colunas) -->
        <section class="animate-slide-up delay-300">
            <div class="flex flex-col md:flex-row md:items-end justify-between font-heading font-black text-principal mb-8 sm:mb-12">
                <h2 class="text-4xl sm:text-6xl uppercase leading-[0.9] border-b-8 border-destaque inline-block pb-2 w-max">
                    A Estrutura
                </h2>
                <div class="text-2xl sm:text-3xl mt-4 md:mt-0 opacity-50"># PORTO ALEGRE</div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Highlight 1 -->
                <div class="bg-white border-4 border-principal neo-shadow p-6 group hover:-translate-y-2 transition-transform">
                    <div class="text-5xl sm:text-6xl mb-4 group-hover:scale-110 transition-transform origin-left">🛋️</div>
                    <h3 class="text-2xl font-black text-principal uppercase mb-3 bg-destaque inline-block px-2 group-hover:text-white group-hover:bg-principal transition-colors">Salas de Jogos e Convívio</h3>
                    <p class="text-slate-600 font-bold leading-snug">
                        Temos salas climatizadas, amplo estacionamento, sofás gigantes e mesas de ping-pong. O lugar perfeito para relaxar, estudar ou bater um papo.
                    </p>
                </div>

                <!-- Highlight 2 -->
                <div class="bg-white border-4 border-principal neo-shadow p-6 group hover:-translate-y-2 transition-transform">
                    <div class="text-5xl sm:text-6xl mb-4 group-hover:scale-110 transition-transform origin-left">🎓</div>
                    <h3 class="text-2xl font-black text-principal uppercase mb-3 bg-[#25D366] text-white inline-block px-2 group-hover:text-[#25D366] group-hover:bg-principal transition-colors">Professores Inspirados</h3>
                    <p class="text-slate-600 font-bold leading-snug">
                        Nosso corpo docente é composto por servidores e voluntários incrivelmente preparados para tirar suas dúvidas difíceis e debater o evangelho hoje.
                    </p>
                </div>

                <!-- Highlight 3 -->
                <div class="bg-white border-4 border-principal neo-shadow p-6 group hover:-translate-y-2 transition-transform">
                    <div class="text-5xl sm:text-6xl mb-4 group-hover:scale-110 transition-transform origin-left">🎸</div>
                    <h3 class="text-2xl font-black text-principal uppercase mb-3 bg-principal text-white inline-block px-2 group-hover:text-principal group-hover:bg-destaque transition-colors">Eventos Semanais</h3>
                    <p class="text-slate-600 font-bold leading-snug">
                        Caravanas pro templo, devocionais mundiais, luaus e festas institucionais. O instituto reúne a melhor juventude cristã do Rio Grande do Sul.
                    </p>
                </div>
            </div>

            <!-- Galeria de Ambientes - Bento Grid -->
            <div class="mt-12 sm:mt-16 w-full relative">
                <div class="flex flex-col md:flex-row md:items-end justify-between font-heading font-black text-principal mb-6">
                    <h3 class="text-3xl sm:text-5xl uppercase leading-[0.9] border-b-8 border-destaque inline-block pb-2 w-max mt-4">
                        Conheça os<br/><span class="text-destaque" style="-webkit-text-stroke: 1px var(--color-principal);">Ambientes</span>
                    </h3>
                </div>

                <!-- Bento Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 mt-8 w-full auto-rows-[250px] sm:auto-rows-[300px] lg:auto-rows-[360px]">
                    
                    <!-- Foto 1 (Destaque, 2 colunas) -->
                    <div class="md:col-span-2 relative group overflow-hidden border-4 border-principal neo-shadow w-full h-full transform transition-transform hover:-translate-y-1 hover:rotate-1 bg-principal">
                        <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=1200&auto=format&fit=crop" alt="Convívio e Sofás" class="w-full h-full object-cover grayscale-[0.4] contrast-125 opacity-80 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-principal/90 via-principal/20 to-transparent pointer-events-none"></div>
                        <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8 z-10 flex flex-col items-start translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                            <span class="bg-destaque text-principal px-3 py-1.5 text-sm sm:text-base font-black uppercase tracking-widest border-2 border-principal shadow-[2px_2px_0_0_black]">Lounge Principal</span>
                            <p class="text-white font-bold text-sm sm:text-base max-w-md mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden sm:block">
                                Sofás gigantes e ambiente perfeito para conversar, relaxar ou jogar ping-pong antes e depois das aulas.
                            </p>
                        </div>
                    </div>

                    <!-- Foto 2 (1 coluna) -->
                    <div class="md:col-span-1 relative group overflow-hidden border-4 border-principal neo-shadow w-full h-full transform transition-transform hover:-translate-y-1 hover:-rotate-1 bg-principal">
                        <img src="https://images.unsplash.com/photo-1577415124269-fc1140a69e91?q=80&w=800&auto=format&fit=crop" alt="Salas Climatizadas" class="absolute inset-0 w-full h-full object-cover grayscale-[0.4] contrast-125 opacity-80 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-principal/90 via-principal/20 to-transparent pointer-events-none"></div>
                        <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8 z-10 flex flex-col items-start translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                            <span class="bg-[#25D366] text-white px-3 py-1.5 text-sm font-black uppercase tracking-widest border-2 border-principal shadow-[2px_2px_0_0_black]">Salas de Aula</span>
                        </div>
                    </div>

                    <!-- Foto 3 (1 coluna) -->
                    <div class="md:col-span-1 relative group overflow-hidden border-4 border-principal neo-shadow w-full h-full transform transition-transform hover:-translate-y-1 hover:rotate-1 bg-principal">
                        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop" alt="Estacionamento e Estrutura Externa" class="absolute inset-0 w-full h-full object-cover grayscale-[0.4] contrast-125 opacity-80 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-principal/90 via-principal/20 to-transparent pointer-events-none"></div>
                        <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8 z-10 flex flex-col items-start translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                            <span class="bg-blue-400 text-white px-3 py-1.5 text-sm font-black uppercase tracking-widest border-2 border-principal shadow-[2px_2px_0_0_black]">Co-worker</span>
                        </div>
                    </div>

                    <!-- Foto 4 (Destaque, 2 colunas) -->
                    <div class="md:col-span-2 relative group overflow-hidden border-4 border-principal neo-shadow w-full h-full transform transition-transform hover:-translate-y-1 hover:-rotate-1 bg-principal">
                        <img src="https://images.unsplash.com/photo-1511116173007-8461abfd4bea?q=80&w=1200&auto=format&fit=crop" alt="Festas e Eventos" class="w-full h-full object-cover grayscale-[0.4] contrast-125 opacity-80 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-principal/90 via-principal/20 to-transparent pointer-events-none"></div>
                        <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8 z-10 flex flex-col items-start translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                            <span class="bg-white text-principal px-3 py-1.5 text-sm sm:text-base font-black uppercase tracking-widest border-2 border-principal shadow-[2px_2px_0_0_black]">Salão de Eventos</span>
                            <p class="text-white font-bold text-sm sm:text-base max-w-md mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden sm:block">
                                Amplo espaço e palco para nossas noites de jogos, devocionais musicais e grandes festas institucionais.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="max-w-4xl mx-auto w-full animate-slide-up delay-400 mt-8 mb-12">
            <h2 class="text-3xl sm:text-5xl font-heading font-black text-principal uppercase leading-[1] mb-8 text-center sm:text-left border-b-4 border-destaque inline-block pb-2 w-full sm:w-auto">
                Perguntas<br/>Frequentes
            </h2>
            
            <div class="flex flex-col gap-4">
                <!-- FAQ Item 1 -->
                <details class="group bg-white border-4 border-principal neo-shadow overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex justify-between items-center font-bold text-lg sm:text-xl text-principal p-5 sm:p-6 cursor-pointer list-none group-hover:bg-destaque transition-colors relative z-10 font-heading uppercase">
                        <span>Preciso ser membro da igreja para participar?</span>
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                        </span>
                    </summary>
                    <div class="p-5 sm:p-6 text-slate-700 font-bold border-t-4 border-principal bg-white group-open:animate-fade-in relative z-0">
                        <p><strong>De jeito nenhum!</strong> Todos os jovens adultos, de todas as crenças e origens, são extremamente bem-vindos para frequentar nossas aulas semanais, usar as salas de jogos e participar dos nossos eventos e festas.</p>
                    </div>
                </details>

                <!-- FAQ Item 2 -->
                <details class="group bg-white border-4 border-principal neo-shadow overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex justify-between items-center font-bold text-lg sm:text-xl text-principal p-5 sm:p-6 cursor-pointer list-none group-hover:bg-destaque transition-colors relative z-10 font-heading uppercase">
                        <span>As aulas têm algum custo?</span>
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                        </span>
                    </summary>
                    <div class="p-5 sm:p-6 text-slate-700 font-bold border-t-4 border-principal bg-white group-open:animate-fade-in relative z-0">
                        <p><strong>Não. Zero. Niente.</strong> Todas as classes de Instituto, materiais curriculares de estudo e acesso às dependências do prédio são <span class="bg-destaque px-1">100% gratuitos</span>.</p>
                    </div>
                </details>

                <!-- FAQ Item 3 -->
                <details class="group bg-white border-4 border-principal neo-shadow overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex justify-between items-center font-bold text-lg sm:text-xl text-principal p-5 sm:p-6 cursor-pointer list-none group-hover:bg-destaque transition-colors relative z-10 font-heading uppercase">
                        <span>Como eu me inscrevo em uma turma?</span>
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                        </span>
                    </summary>
                    <div class="p-5 sm:p-6 text-slate-700 font-bold border-t-4 border-principal bg-white group-open:animate-fade-in relative z-0">
