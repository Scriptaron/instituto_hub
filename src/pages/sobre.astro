---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/organisms/FAQ.astro';
import { Image } from 'astro:assets';
import imgProposito from '../assets/img_proposito.jpg';
import dirMarco from '../assets/diretor-marco.jpg';
import dirJair from '../assets/diretor-jair.jpg';
import dirRobson from '../assets/diretor-robson.jpg';
import dirGeraldo from '../assets/diretor-geraldo.jpg';
import dirHeberto from '../assets/diretor-heberto.jpg';
import dirEverton from '../assets/diretor-everton.jpg';
import NeoButton from '../components/atoms/NeoButton.astro';
import imgEntrada from '../assets/entrada-instituto.jpg';
import imgSalaAula from '../assets/sala-aula.jpg';
import imgSalaJogos from '../assets/sala-jogos.jpg';
import dirGal from '../assets/diretor-gal.jpg';
import imgChurrasqueira from '../assets/churrasqueira.webp';
import imgQuadra from '../assets/quadra.webp';

export const prerender = true;
---

<BaseLayout title="Sobre - Instituto Hub">
    <main class="container mx-auto px-4 py-8 md:py-16 max-w-6xl flex flex-col gap-12 sm:gap-20 relative z-10">
        
        
        <section class="bg-principal text-white p-6 sm:p-8 md:p-10 animate-slide-up w-full relative rounded-2xl">
            <div class="absolute -top-4 -left-4 sm:-top-6 sm:-left-6 w-12 h-12 sm:w-16 sm:h-16 bg-destaque border-4 border-principal rounded-full z-20 flex items-center justify-center text-2xl sm:text-3xl neo-shadow transform -rotate-12">
                🏛️
            </div>

            
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start w-full relative z-10 pt-4">
                
                
                <div class="w-full lg:w-[30%] shrink-0 flex flex-col pt-0 lg:pt-2">
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-black uppercase leading-[0.9] tracking-tighter mb-8">
                        Nossa<br/>
                        <span class="text-destaque" style="-webkit-text-stroke: 1px var(--color-principal);">História</span>
                    </h1>
                    <p class="text-base sm:text-lg font-bold leading-relaxed opacity-80">
                        Conheça o Instituto de Religião de Porto Alegre e descubra por que milhares de jovens adultos se reúnem aqui.
                    </p>
                </div>

                
                <div class="w-full lg:w-[26%] shrink-0 relative flex flex-col items-center mx-auto lg:mx-0 mt-6 lg:mt-0">
                    
                    <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-destaque text-principal font-heading font-black uppercase text-xs sm:text-sm tracking-widest px-4 py-1.5 border-2 border-black shadow-[2px_2px_0_0_black] -rotate-2 w-max z-30 pointer-events-none">
                        Nossos Diretores
                    </div>

                    
                    <div class="relative flex items-center justify-center pt-10 w-full gap-2">
                        
                        <button id="btn-prev-diretor" aria-label="Diretor Anterior" class="shrink-0 z-30 bg-transparent text-destaque p-1.5 transition-transform hover:scale-110 active:scale-95 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        </button>

                        
                        <div id="carousel-diretores" class="w-[200px] flex overflow-hidden snap-x snap-mandatory scroll-smooth shrink-0">
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-yellow-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <Image src={dirMarco} alt="Marco Antônio Rais" class="w-full h-full object-cover object-top grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Marco Rais</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">1995 - 2002</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform -rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-pink-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <Image src={dirJair} alt="Jair Chagas Brollo" class="w-full h-full object-cover object-top grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Jair Brollo</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2002 - 2004</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-2 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-blue-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-principal mb-2">
                                        <Image src={dirRobson} alt="Robson Marcanch Medeiros" class="w-full h-full object-cover object-[30%_top] grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1" title="Robson Marcanch Medeiros">Robson Medeiros</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2005 - 2012</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform -rotate-2 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-yellow-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <Image src={dirGeraldo} alt="Geraldo Oliveira" class="w-full h-full object-cover object-top grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Geraldo Oliveira</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2012 - 2014</span>
                                    </div>
                                </div>
                            </div>

                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-blue-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <Image src={dirGal} alt="Thiago Gal" class="w-full h-full object-cover object-top grayscale-[0.3] scale-[1.8] origin-[48%_55%]" />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Thiago Gal</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2014 - 2017</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform -rotate-1 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-pink-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-destaque mb-2">
                                        <Image src={dirHeberto} alt="Herberto Morôni Klein" class="w-full h-full object-cover object-top grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Herberto Klein</p>
                                        <span class="bg-principal text-white px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2018 - 2019</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="snap-center shrink-0 w-[200px] flex justify-center py-2">
                                <div class="bg-white p-2 pb-14 transform rotate-2 w-[184px] relative text-principal outline outline-1 outline-transparent ring-1 ring-transparent">
                                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-4 bg-blue-100 opacity-90 z-10 pointer-events-none"></div>
                                    <div class="w-full aspect-[4/5] overflow-hidden bg-principal mb-2">
                                        <Image src={dirEverton} alt="Everton Freitas" class="w-full h-full object-cover object-top grayscale-[0.3] " />
                                    </div>
                                    <div class="absolute bottom-3 w-full left-0 text-center flex flex-col items-center">
                                        <p class="font-heading font-black text-principal text-xs uppercase truncate w-full px-1">Everton Freitas</p>
                                        <span class="bg-destaque text-principal px-2 py-0.5 text-[0.55rem] font-black uppercase tracking-widest mt-0.5">2020 - Atual</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        
                        <button id="btn-next-diretor" aria-label="Próximo Diretor" class="shrink-0 z-30 bg-transparent text-destaque p-1.5 transition-transform hover:scale-110 active:scale-95 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>

                    <script>
                        document.addEventListener('astro:page-load', () => {
                            const carousel = document.getElementById('carousel-diretores');
                            const btnPrev = document.getElementById('btn-prev-diretor');
                            const btnNext = document.getElementById('btn-next-diretor');
                            if (carousel && btnPrev && btnNext) {
                                const update = () => {
                                    const max = carousel.scrollWidth - carousel.clientWidth;
                                    btnPrev.style.visibility = carousel.scrollLeft <= 5 ? 'hidden' : 'visible';
                                    btnNext.style.visibility = carousel.scrollLeft >= max - 5 ? 'hidden' : 'visible';
                                };
                                btnNext.addEventListener('click', () => carousel.scrollBy({ left: carousel.clientWidth, behavior: 'smooth' }));
                                btnPrev.addEventListener('click', () => carousel.scrollBy({ left: -carousel.clientWidth, behavior: 'smooth' }));
                                carousel.addEventListener('scroll', update);
                                setTimeout(update, 100);
                            }
                        });
                    </script>
                </div>

                
                <div class="w-full lg:flex-1 flex justify-center lg:justify-end mt-10 lg:mt-0">
                    <div class="bg-white p-3 pb-16 sm:p-4 sm:pb-20 transform rotate-2 w-full max-w-[380px] sm:max-w-[440px] group relative text-principal outline outline-[1.5px] outline-transparent ring-1 ring-transparent">
                        
                        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-20 h-8 bg-yellow-100 opacity-90 transform -rotate-3 z-10 pointer-events-none shadow-sm drop-shadow-sm"></div>
                        
                        <div class="w-full aspect-[4/3] overflow-hidden bg-slate-200 mb-2">
                            <Image src={imgEntrada} alt="Foto da entrada do Instituto" class="w-full h-full object-cover grayscale-[0.3] contrast-125" />
                        </div>
                        <div class="absolute bottom-5 sm:bottom-6 w-full left-0 text-center px-4 flex flex-col items-center">
                            <p class="font-heading font-black text-principal text-lg sm:text-xl uppercase tracking-wider">O Início</p>
                            <p class="font-bold text-slate-500 text-[0.65rem] sm:text-xs mt-0.5 uppercase tracking-wide">A Sede Oficial do Instituto</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 animate-slide-up delay-100">
            
            <div class="bg-white border-4 border-principal p-6 sm:p-10 flex flex-col justify-center transform -rotate-1 rounded-2xl">
                <h2 class="text-3xl sm:text-5xl font-heading font-black text-principal uppercase leading-[1] mb-6 border-b-4 border-destaque inline-block w-max pb-2">
                    Qual o<br/>Nosso Propósito?
                </h2>
                <p class="text-base sm:text-lg font-bold text-slate-600 mb-4 leading-relaxed">
                    O Instituto de Religião é muito mais do que um prédio ou uma sala de aula. É um <strong class="text-principal">refúgio espiritual</strong> projetado especificamente para jovens adultos solteiros e casados (de 18 a 35 anos).
                </p>
                <p class="text-base sm:text-lg font-bold text-slate-600 leading-relaxed">
                    Nosso objetivo é ajudar você a compreender e confiar nos ensinamentos e na Expiação de Jesus Cristo, a se qualificar para as bênçãos do templo e a preparar a si mesmo, sua família e outras pessoas para a vida eterna.
                </p>
            </div>
            
            
            <div class="bg-destaque border-4 border-principal neo-shadow overflow-hidden transform rotate-1 hover:-rotate-1 transition-transform relative h-[300px] sm:h-[400px] lg:h-full lg:min-h-[400px] group rounded-2xl neo-halftone">
                <Image src={imgProposito} alt="Grupo de jovens no instituto reunidos e sorrindo" class="absolute inset-0 w-full h-full object-cover [@media(hover:hover)]:grayscale-[0.3] contrast-125 [@media(hover:hover)]:group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 " />
            </div>
        </section>

        
        <section class="bg-slate-800 text-white border-4 border-principal neo-shadow p-8 sm:p-12 md:p-16 animate-slide-up delay-200 w-full relative overflow-hidden rounded-2xl">
            <div class="absolute -top-10 -right-10 text-[10rem] sm:text-[15rem] text-destaque font-black opacity-10 leading-none pointer-events-none">
                "
            </div>
            <p class="text-2xl sm:text-4xl md:text-5xl font-black font-heading leading-tight max-w-4xl relative z-10 hover:text-destaque transition-colors">
                O Instituto é o baluarte espiritual que todo jovem adulto precisa para não se perder nas névoas de escuridão do mundo moderno.
            </p>
            <div class="mt-8 bg-principal text-destaque uppercase tracking-widest font-black text-xs sm:text-sm relative z-10 w-max px-6 py-4 flex items-center justify-center leading-none">
                A liderança local
            </div>
        </section>

        <!-- Horários de Funcionamento e Status Detalhado -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 animate-slide-up delay-200">
            <div class="bg-white border-4 border-principal p-6 sm:p-10 flex flex-col justify-center rounded-2xl">
                <h2 class="text-3xl sm:text-5xl font-heading font-black text-principal uppercase leading-[1] mb-6 border-b-4 border-destaque inline-block w-max pb-2">
                    Horários de<br/>Funcionamento
                </h2>
                
                <div class="flex flex-col gap-4 text-slate-700 font-bold">
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-1">
                        <span>Segunda-feira</span>
                        <span class="text-principal">08:00 - 17:00</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-2">
                        <span>Terça-feira</span>
                        <span class="text-principal">08:00 - 17:00</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-3">
                        <span>Quarta-feira</span>
                        <span class="text-principal">14:00 - 22:00</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-4">
                        <span>Quinta-feira</span>
                        <span class="text-principal">14:00 - 22:00</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-5">
                        <span>Sexta-feira</span>
                        <span class="text-slate-400">Fechado</span>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b-2 border-slate-100" id="schedule-day-6">
                        <span>Sábado</span>
                        <span class="text-principal">08:00 - 17:00</span>
                    </div>
                    <div class="flex justify-between items-center py-2" id="schedule-day-0">
                        <span>Domingo</span>
                        <span class="text-slate-400">Fechado</span>
                    </div>
                </div>
            </div>
            
            <div class="bg-principal text-white border-4 border-principal neo-shadow p-6 sm:p-10 flex flex-col justify-between rounded-2xl relative overflow-hidden" id="sobre-status-card">
                <div class="absolute -right-16 -top-16 w-48 h-48 bg-destaque/10 rounded-full blur-3xl pointer-events-none"></div>
                <div>
                    <span class="bg-destaque text-principal px-3 py-1.5 text-xs font-black uppercase tracking-widest border-2 border-principal shadow-[2px_2px_0_0_black] inline-block mb-6">Status em Tempo Real</span>
                    <h3 class="text-4xl sm:text-5xl font-black font-heading uppercase leading-none mb-4" id="sobre-status-title">Carregando...</h3>
                    <p class="text-sm sm:text-base font-bold text-slate-200" id="sobre-status-desc">Verificando horário de funcionamento...</p>
                </div>
                
                <div class="mt-8 flex items-center gap-4">
                    <span class="relative flex h-4 w-4">
                        <span id="sobre-status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
                        <span id="sobre-status-dot" class="relative inline-flex rounded-full h-4 w-4"></span>
                    </span>
                    <span class="text-base sm:text-lg font-black uppercase tracking-wider" id="sobre-status-badge-text">...</span>
                </div>
            </div>
        </section>

        <script>
            document.addEventListener('astro:page-load', () => {
                const formatter = new Intl.DateTimeFormat('en-US', {
                    timeZone: 'America/Sao_Paulo',
                    hour12: false,
                    hour: 'numeric',
                    minute: 'numeric',
                    weekday: 'short'
                });
                const parts = formatter.formatToParts(new Date());
                const partMap = Object.fromEntries(parts.map(p => [p.type, p.value])) as any;
                
                const weekdayMap: any = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
                const day = weekdayMap[partMap.weekday];
                const hour = parseInt(partMap.hour, 10);
                const min = parseInt(partMap.minute, 10);
                const timeInMinutes = hour * 60 + min;
                
                // Destacar dia atual na lista
                const currentDayEl = document.getElementById(`schedule-day-${day}`);
                if (currentDayEl) {
                    currentDayEl.classList.add('bg-destaque/10', 'border-principal', 'p-2', 'rounded-lg');
                    currentDayEl.classList.remove('border-slate-100');
                    const label = currentDayEl.querySelector('span:first-child');
                    if (label && !label.textContent.includes('(Hoje)')) {
                        label.textContent += ' (Hoje)';
                    }
                }
                
                let isOpen = false;
                if (day === 1 || day === 2 || day === 6) {
                    isOpen = timeInMinutes >= 8 * 60 && timeInMinutes < 17 * 60;
                } else if (day === 3 || day === 4) {
                    isOpen = timeInMinutes >= 14 * 60 && timeInMinutes < 22 * 60;
                }
                
                const titleEl = document.getElementById('sobre-status-title');
                const descEl = document.getElementById('sobre-status-desc');
                const pingEl = document.getElementById('sobre-status-ping');
                const dotEl = document.getElementById('sobre-status-dot');
                const textEl = document.getElementById('sobre-status-badge-text');
                
                if (titleEl && descEl && dotEl && textEl) {
                    if (isOpen) {
                        titleEl.textContent = 'Estamos Abertos!';
                        descEl.textContent = 'Venha estudar, usar o Wi-Fi, jogar pingue-pongue ou participar de nossas atividades.';
                        dotEl.className = 'relative inline-flex rounded-full h-4 w-4 bg-destaque';
                        if (pingEl) pingEl.className = 'animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-destaque';
                        textEl.textContent = 'Aberto Agora';
                        textEl.className = 'text-base sm:text-lg font-black uppercase tracking-wider text-destaque';
                    } else {
                        titleEl.textContent = 'Estamos Fechados';
                        descEl.textContent = 'No momento a sede está fechada. Confira nossa tabela de horários para programar sua visita.';
                        dotEl.className = 'relative inline-flex rounded-full h-4 w-4 bg-slate-400';
                        if (pingEl) pingEl.className = 'hidden';
                        textEl.textContent = 'Fechado';
                        textEl.className = 'text-base sm:text-lg font-black uppercase tracking-wider text-slate-300';
                    }
                }
            });
        </script>

        
        <section class="animate-slide-up delay-300">
            <div class="flex flex-col md:flex-row md:items-end justify-between font-heading font-black text-principal mb-8 sm:mb-12">
                <h2 class="text-4xl sm:text-6xl uppercase leading-[0.9] border-b-8 border-destaque inline-block pb-2 w-max">
                    A Estrutura
                </h2>
                <div class="text-2xl sm:text-3xl mt-4 md:mt-0 opacity-50"># PORTO ALEGRE</div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                
                <div class="bg-white border-4 border-principal neo-shadow p-6 group hover:-translate-y-2 transition-transform rounded-2xl">
                    <div class="text-5xl sm:text-6xl mb-4 group-hover:scale-110 transition-transform origin-left">🛋️</div>
                    <h3 class="text-2xl font-black text-principal uppercase mb-3 bg-destaque inline-block px-2 group-hover:text-white group-hover:bg-principal transition-colors">Salas de Jogos e Convívio</h3>
                    <p class="text-slate-600 font-bold leading-snug">
                        Temos salas climatizadas, amplo estacionamento, sofás gigantes e mesas de ping-pong. O lugar perfeito para relaxar, estudar ou bater um papo.
                    </p>
                </div>

                
                <div class="bg-white border-4 border-principal neo-shadow p-6 group hover:-translate-y-2 transition-transform rounded-2xl">
                    <div class="text-5xl sm:text-6xl mb-4 group-hover:scale-110 transition-transform origin-left">🎓</div>
