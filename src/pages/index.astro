---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from 'sanity:client';
import { formatEventDate } from '../utils/sanity';
import TestimonialCarousel from '../components/organisms/TestimonialCarousel.astro';
import { Image } from 'astro:assets';
import imgHero from '../assets/img_herosection.jpg';
import imgAulasDinamicas from '../assets/img_aulas-dinamicas.jpg';
import imgGrid2 from '../assets/img_grid2.jpg';
import imgGrid3 from '../assets/img_grid3.jpg';
import imgAmizadesReais from '../assets/img_amizades-reais.jpg';
import NeoButton from '../components/atoms/NeoButton.astro';
import type { Evento } from '../types';

// Configuração de Cache no Edge (Netlify ISR magico)
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, s-maxage=60, stale-while-revalidate=31536000');

// Busca os 3 próximos eventos com data >= hoje, ordenados por data real
const localDate = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
const year = localDate.getFullYear();
const month = String(localDate.getMonth() + 1).padStart(2, '0');
const day = String(localDate.getDate()).padStart(2, '0');
const today = `${year}-${month}-${day}`; // Formato: AAAA-MM-DD no timezone de Porto Alegre
const proximosEventos = await sanityClient.fetch(
  `*[_type == "evento" && eventDate >= $today] | order(eventDate asc) [0...3] {
    title,
    eventDate
  }`,
  { today }
);


---

<BaseLayout title="Instituto Hub - Porto Alegre" overflowHidden={false}>
		
		<div class="fixed top-[-5vw] left-[-5vw] w-[40vw] h-[40vw] bg-destaque/20 rounded-full blur-[100px] -z-10 animate-slide-up pointer-events-none"></div>

		<main class="container mx-auto px-4 py-8 md:py-16 max-w-7xl flex flex-col gap-12 sm:gap-16 md:gap-32 relative z-10">
			
			
			<section class="flex flex-col lg:flex-row items-center gap-6 sm:gap-8 lg:gap-16 pt-2 sm:pt-4 md:pt-12 animate-slide-up">
				<div class="flex-1 flex flex-col gap-4 sm:gap-6 w-full">
					<p class="font-bold text-principal tracking-widest uppercase border-b-4 border-principal inline-block w-max pb-1 text-xs sm:text-sm md:text-base">Porto Alegre</p>
					<h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[8rem] font-heading font-black text-principal leading-[0.85] tracking-normal w-full">
						INSTITUTO<br/>
						<span class="text-destaque stroke-text">HUB</span>
					</h1>

					<style>
						.stroke-text {
							-webkit-text-stroke: 1.5px var(--color-principal);
						}
						@media (min-width: 768px) {
							.stroke-text {
								-webkit-text-stroke: 3px var(--color-principal);
							}
						}
						@media (min-width: 1024px) {
							.stroke-text {
								-webkit-text-stroke: 4px var(--color-principal);
							}
						}
					</style>
					<div class="bg-white p-4 md:p-6 border-4 border-principal neo-shadow mt-2 sm:mt-4 rounded-2xl">
                        <p class="text-lg sm:text-xl md:text-3xl text-principal font-black font-heading leading-tight mb-2">
                            "A glória de Deus é a inteligência."
                        </p>
                        <p class="text-base sm:text-lg md:text-xl text-slate-700 font-bold">
                            Prepare-se para o futuro e obtenha toda a educação que puder.
                        </p>
                    </div>
					<div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-4 sm:mt-6 w-full">
						
						<NeoButton href="/aulas" variant="primary" size="lg" class="py-3 h-auto text-base sm:text-lg md:text-2xl font-black uppercase tracking-wider px-6 sm:px-8 flex-1 md:flex-none">
							Inscreva-se nas Aulas
						</NeoButton>
					</div>
				</div>
                <div class="flex-1 w-full bg-destaque border-4 border-principal neo-shadow p-3 md:p-6 lg:rotate-2 hover:rotate-0 transition-transform duration-300 rounded-2xl neo-halftone">
                    <Image src={imgHero} alt="Jovens no instituto" class="w-full h-[300px] md:h-[400px] lg:h-[500px] object-cover border-4 border-principal grayscale sepia-[0.3] contrast-125 hover:grayscale-0 transition-all duration-500 rounded-2xl" />
                </div>
			</section>

			
			<section class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 relative animate-slide-up delay-100">
				
				
				<div class="md:col-span-7 bg-white p-5 sm:p-6 md:p-10 border-4 border-principal neo-shadow group flex flex-col relative z-20 rounded-2xl">
                    <div class="absolute -top-6 -right-6 w-12 h-12 bg-destaque border-4 border-principal rounded-full hidden lg:block animate-float z-30" aria-hidden="true"></div>
					<div class="flex justify-between items-start mb-8 sm:mb-10 md:mb-14">
						<h2 class="text-3xl sm:text-4xl md:text-6xl font-heading font-black text-principal leading-[0.9] uppercase">
							Próximos<br/>Eventos
						</h2>
						<div class="text-destaque text-4xl sm:text-5xl group-hover:rotate-12 transition-transform duration-300">🌟</div>
					</div>
					<ul class="flex flex-col border-y-4 border-principal divide-y-4 divide-principal mt-auto">
						{proximosEventos.length > 0 ? (
							proximosEventos.map((evt: Evento, i: number) => {
								const bgClass = i === 1 ? 'bg-principal text-white' : 'bg-destaque text-principal';
								return (
									<li class="flex flex-col sm:flex-row items-stretch group/item hover:bg-principal/5 transition-colors">
										<div class={`${bgClass} sm:border-r-4 sm:border-b-0 border-b-4 border-principal font-black p-4 md:p-6 text-xl md:text-2xl sm:w-32 md:w-40 flex items-center justify-center font-heading text-center leading-tight`}>
											{formatEventDate(evt.eventDate)}
										</div>
										<div class="font-bold text-slate-800 text-lg sm:text-xl md:text-3xl p-4 md:p-6 flex items-center flex-1 justify-center sm:justify-start text-center sm:text-left">{evt.title}</div>
									</li>
								)
							})
						) : (
							<li class="flex flex-col items-center justify-center py-10 gap-3 text-center">
								<span class="text-4xl">📭</span>
								<p class="font-black text-principal uppercase text-lg">Sem eventos por enquanto!</p>
								<p class="text-slate-500 font-bold text-sm">Fique de olho no Instagram para as próximas novidades.</p>
							</li>
						)}
					</ul>
					
					
					<NeoButton href="/cronograma" variant="highlight" class="block w-full text-center mt-8 sm:mt-10 py-3 sm:py-4 md:py-5 h-auto text-lg sm:text-xl md:text-2xl font-black uppercase tracking-wider relative overflow-hidden group">
                        Ver Programação Completa
					</NeoButton>
				</div>

				
				<div class="md:col-span-5 flex flex-col gap-6 sm:gap-8">
                    <div class="bg-principal text-white p-5 sm:p-6 md:p-10 border-4 border-principal neo-shadow relative lg:rotate-3 hover:rotate-0 transition-transform duration-300 z-10 flex-1 flex flex-col justify-between overflow-hidden rounded-2xl">
                        <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-destaque rounded-full blur-2xl opacity-40 z-0 pointer-events-none"></div>
                        
                        <div class="relative z-10">
                            <h2 class="text-3xl sm:text-4xl md:text-6xl font-heading font-black mb-4 sm:mb-6 leading-[0.9] uppercase">
                                Grade de<br/><span class="text-destaque">Aulas</span>
                            </h2>
                            <p class="text-lg sm:text-xl md:text-2xl text-blue-50 font-medium mb-8 sm:mb-10 leading-snug">
                                Encontre a classe de Instituto mais próxima, seja presencial ou online.
                            </p>
                        </div>
                        
                        <NeoButton href="/aulas" variant="secondary" class="block w-full text-center py-3 sm:py-4 h-auto text-lg sm:text-xl md:text-3xl font-black mt-auto z-10">
                            Escolher Turma &rarr;
                        </NeoButton>
                    </div>
                </div>
			</section>

            
            <section class="mt-16 relative animate-slide-up delay-100 z-10 w-full overflow-hidden xl:overflow-visible">
                
                <div class="mb-6 md:mb-8 mx-4 lg:mx-0 bg-white border-4 border-principal neo-shadow p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 group hover:-translate-y-1 transition-transform z-20 relative rounded-2xl">
                    <div class="flex-1">
                        <h3 class="text-2xl sm:text-3xl md:text-4xl font-heading font-black text-principal uppercase mb-3 leading-none">
                            Noite de Esportes <span class="bg-destaque text-principal px-2 inline-block -rotate-1 mt-1 sm:mt-0">e Integração</span>
                        </h3>
                        <p class="text-slate-600 font-bold text-base sm:text-lg max-w-3xl leading-relaxed">
                            Todas as <span class="bg-destaque text-principal px-1.5 inline-block -rotate-1">quartas das 19h até as 22h30</span> no Instituto Missionário — traga seus amigos!
                        </p>
                    </div>
                    <div class="text-6xl sm:text-7xl group-hover:scale-110 group-hover:rotate-12 transition-transform origin-center flex-shrink-0 self-start md:self-auto">
                        🏀
                    </div>
                </div>

                
                
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 px-4 lg:px-0">
                    
                    
                    <div class="col-span-1 sm:col-span-2 row-span-2 bg-principal border-4 border-principal neo-shadow relative group rotate-1 hover:rotate-0 transition-transform h-[250px] sm:h-[300px] md:h-[500px] rounded-2xl overflow-hidden neo-halftone">
                        <Image src={imgAulasDinamicas} class="w-full h-full object-cover grayscale-[0.2] contrast-125 group-hover:grayscale-0 transition-all duration-300" alt="Jovens estudando juntos" />
                        <div class="absolute bottom-4 left-4 bg-destaque text-principal font-black font-heading px-4 py-2 border-2 border-principal neo-shadow text-lg sm:text-xl">
                            Aulas Dinâmicas
                        </div>
                    </div>

                    
                    <div class="col-span-1 sm:col-span-1 border-4 border-principal neo-shadow relative group -rotate-2 hover:rotate-0 transition-transform h-[150px] md:h-auto bg-white rounded-2xl overflow-hidden neo-halftone">
                        <Image src={imgGrid2} class="w-full h-full object-cover grayscale-[0.2] contrast-125 group-hover:grayscale-0 transition-all duration-300" alt="Amigos rindo" />
                    </div>

                    
                    <div class="col-span-1 sm:col-span-1 border-4 border-principal neo-shadow relative group rotate-2 hover:rotate-0 transition-transform h-[150px] md:h-auto bg-destaque rounded-2xl overflow-hidden neo-halftone">
                        <Image src={imgGrid3} class="w-full h-full object-cover grayscale-[0.2] contrast-125 group-hover:grayscale-0 transition-all duration-300" alt="Jovens conversando" />
                    </div>

                    
                    <div class="col-span-1 sm:col-span-2 border-4 border-principal neo-shadow relative group -rotate-1 hover:rotate-0 transition-transform h-[180px] md:h-[280px] bg-principal rounded-2xl overflow-hidden neo-halftone">
                        <Image src={imgAmizadesReais} class="w-full h-full object-cover object-[center_30%] grayscale-[0.2] contrast-125 group-hover:grayscale-0 transition-all duration-300" alt="Comunidade unida" />
                        <div class="absolute bottom-4 right-4 bg-white text-principal font-black font-heading px-4 py-2 border-2 border-principal neo-shadow text-base sm:text-lg">
                            Amizades Reais
                        </div>
                    </div>

                </div>
            </section>

            
            <TestimonialCarousel />

            
            <section class="bg-principal text-white border-4 border-principal neo-shadow p-5 sm:p-6 md:p-10 lg:p-16 flex flex-col md:flex-row gap-6 sm:gap-8 md:gap-12 animate-slide-up delay-300 mt-8 sm:mt-0 rounded-2xl">
                <div class="flex-1 flex flex-col justify-center relative z-10">
                    <h2 class="text-4xl sm:text-5xl md:text-7xl font-heading font-black text-destaque uppercase leading-[0.9] mb-4 sm:mb-6">
                        Onde <br/>Estamos
                    </h2>
                    <p class="text-base sm:text-xl md:text-2xl font-medium text-blue-50 mb-6 sm:mb-8">
                        Venha nos visitar! Nosso edifício fica em um local estratégico, fácil de chegar.
                    </p>
                    <a href="https://maps.google.com/maps?q=Av.+Princesa+Isabel,+300+-+Santana,+Porto+Alegre+-+RS" target="_blank" rel="noopener noreferrer" class="bg-white text-principal border-4 border-transparent neo-shadow p-4 sm:p-6 font-bold text-base sm:text-lg md:text-xl transform -rotate-1 w-full max-w-max block rounded-2xl">
                        📍 Av. Princesa Isabel, 300 <br/>
                        Santana, Porto Alegre - RS
                    </a>
                </div>
                <div class="flex-1 bg-white h-[250px] sm:h-[350px] md:h-auto md:min-h-[400px] relative overflow-hidden group">
                    
                    <iframe 
                        title="Mapa de Localização do Instituto Hub"
                        src="https://maps.google.com/maps?q=Av.+Princesa+Isabel,+300+-+Santana,+Porto+Alegre+-+RS&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                        class="absolute inset-0 w-full h-full grayscale-[0.5] contrast-[1.2] group-hover:grayscale-0 transition-all duration-500"
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </section>

		</main>



        <script>
            // Outros scripts se necessário.
        </script>
</BaseLayout>
