    <div class="flex justify-between items-center w-full animate-slide-up flex-row-reverse">
        
        <div class="flex items-center gap-2">
            <div 
                class="w-8 h-8 sm:w-10 sm:h-10 overlay-logo-icon shrink-0 translate-y-[2px]"
                style="-webkit-mask-image: url('/instituto-logo.svg'); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center; mask-image: url('/instituto-logo.svg'); mask-size: contain; mask-repeat: no-repeat; mask-position: center;"
            >
            </div>
            <div class="flex flex-col items-end justify-center text-right">
                <span class="text-xl sm:text-2xl font-black font-heading overlay-logo-text uppercase tracking-tighter leading-none">
                    Instituto Hub
                </span>
                <span class="text-[0.6rem] sm:text-xs font-bold text-white uppercase tracking-[0.2em] mt-0.5 opacity-80 leading-none">
                    Porto Alegre Sul
                </span>
            </div>
        </div>
        
        
        <button id="mobile-menu-close-btn" aria-label="Fechar Menu Principal" class="btn border-4 p-2 neo-shadow h-12 w-12 flex items-center justify-center rounded-2xl active:translate-y-1 focus-visible:outline-none focus-visible:ring-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    
    <nav class="flex flex-col gap-6 my-auto pt-8">
        <a href="/" class={`text-4xl sm:text-5xl font-black font-heading uppercase tracking-wider flex items-center gap-4 transition-all duration-300 w-max ${isActive('/') ? 'active translate-x-2' : 'hover:translate-x-2'}`}>
            <span>Home</span>
            {isActive('/') && <span class="indicator-finger text-3xl">👈</span>}
        </a>
        <a href="/aulas" class={`text-4xl sm:text-5xl font-black font-heading uppercase tracking-wider flex items-center gap-4 transition-all duration-300 w-max ${isActive('/aulas') ? 'active translate-x-2' : 'hover:translate-x-2'}`}>
            <span>Aulas</span>
            {isActive('/aulas') && <span class="indicator-finger text-3xl">👈</span>}
        </a>
        <a href="/cronograma" class={`text-4xl sm:text-5xl font-black font-heading uppercase tracking-wider flex items-center gap-4 transition-all duration-300 w-max ${isActive('/cronograma') ? 'active translate-x-2' : 'hover:translate-x-2'}`}>
            <span>Cronograma</span>
            {isActive('/cronograma') && <span class="indicator-finger text-3xl">👈</span>}
        </a>
        <a href="/sobre" class={`text-4xl sm:text-5xl font-black font-heading uppercase tracking-wider flex items-center gap-4 transition-all duration-300 w-max ${isActive('/sobre') ? 'active translate-x-2' : 'hover:translate-x-2'}`}>
            <span>Sobre</span>
            {isActive('/sobre') && <span class="indicator-finger text-3xl">👈</span>}
        </a>
    </nav>

    
    <div class="flex flex-col gap-6 border-t-4 border-white/20 pt-6 mt-auto">
        <div class="flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
            <div>
                <p class="text-xs uppercase tracking-widest overlay-logo-text font-black mb-1">Dúvidas ou Informações?</p>
                <p class="text-sm font-bold text-slate-200">Seg a Sáb • Prédio Santana</p>
                <div id="status-indicator-mobile" class="flex items-center gap-2 bg-slate-900 border-2 border-white/20 px-3 py-1.5 text-xs font-black uppercase text-white w-max rounded-lg mt-2">
                    <span class="relative flex h-2.5 w-2.5">
                        <span id="status-dot-ping-mobile" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-green-400"></span>
                        <span id="status-dot-mobile" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
                    </span>
                    <span id="status-text-mobile">...</span>
                </div>
            </div>
            
            <div class="flex gap-4">
                <a href="https://wa.me/555191774826?text=Ol%C3%A1%2C%20tenho%20d%C3%BAvidas%20sobre%20o%20Instituto%21" target="_blank" rel="noopener noreferrer" class="btn bg-whatsapp text-white border-2 border-white hover:bg-whatsapp-hover font-black uppercase text-xs neo-shadow px-4 h-10 flex items-center gap-2 rounded-xl">
                    WhatsApp
                </a>
                <a href="https://www.instagram.com/institutopoa/" target="_blank" rel="noopener noreferrer" class="btn bg-white text-principal border-2 border-principal hover:bg-destaque font-black uppercase text-xs neo-shadow px-4 h-10 flex items-center gap-2 rounded-xl">
                    Instagram
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById('theme-toggle');
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');

        function updateIcons(isDark: boolean) {
            if (!sunIcon || !moonIcon) return;
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        const isCurrentDark = document.documentElement.classList.contains('dark');
        updateIcons(isCurrentDark);

        if (toggleBtn) {
            toggleBtn.replaceWith(toggleBtn.cloneNode(true));
        }

        const newToggleBtn = document.getElementById('theme-toggle');
        newToggleBtn?.addEventListener('click', (event) => {
            const isDark = document.documentElement.classList.contains('dark');
            const willBeDark = !isDark;
            
            const toggleTheme = () => {
                if (willBeDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dracula');
                    localStorage.setItem('theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'lofi');
                    localStorage.setItem('theme', 'light');
                }
                updateIcons(willBeDark);
            };

            const transitionSupported = (document as any).startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!transitionSupported) {
                toggleTheme();
                return;
            }

            const mouseEvent = event as MouseEvent;
            const x = mouseEvent.clientX;
            const y = mouseEvent.clientY;
            const endRadius = Math.hypot(
                Math.max(x, window.innerWidth - x),
                Math.max(y, window.innerHeight - y)
            );

            const transition = (document as any).startViewTransition(() => {
                toggleTheme();
            });

            transition.ready.then(() => {
                const clipPath = [
                    `circle(0px at ${x}px ${y}px)`,
                    `circle(${endRadius}px at ${x}px ${y}px)`
                ];
                document.documentElement.animate(
                    {
                        clipPath: clipPath
                    },
                    {
                        duration: 450,
                        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
                        pseudoElement: '::view-transition-new(root)'
                    }
                );
            });
        });

        // LÓGICA DE STATUS
        const updateStatus = () => {
            const tzDate = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
            const day = tzDate.getDay();
            const hour = tzDate.getHours();
            const min = tzDate.getMinutes();
            const timeInMinutes = hour * 60 + min;

            let isOpen = false;
            if (day === 1 || day === 2 || day === 6) { // Seg, Ter, Sáb
                isOpen = timeInMinutes >= 8 * 60 && timeInMinutes < 17 * 60;
            } else if (day === 3 || day === 4) { // Qua, Qui
                isOpen = timeInMinutes >= 14 * 60 && timeInMinutes < 22 * 60;
            }

            const headerIndicator = document.getElementById('status-indicator');
            const mobileIndicator = document.getElementById('status-indicator-mobile');

            const setIndicator = (indicator: HTMLElement | null, isMob: boolean) => {
                if (!indicator) return;
                const dot = indicator.querySelector(isMob ? '#status-dot-mobile' : '#status-dot') as HTMLElement;
                const ping = indicator.querySelector(isMob ? '#status-dot-ping-mobile' : '#status-dot-ping') as HTMLElement;
                const txt = indicator.querySelector(isMob ? '#status-text-mobile' : '#status-text') as HTMLElement;

                if (isOpen) {
                    dot.className = `relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500`;
                    if (ping) {
                        ping.className = `animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-green-400`;
                    }
                    txt.textContent = 'Aberto Agora';
                    if (!isMob) {
                        indicator.classList.remove('border-principal', 'text-principal');
                        indicator.classList.add('border-green-600', 'text-green-600');
                    }
                } else {
                    dot.className = `relative inline-flex rounded-full h-2.5 w-2.5 bg-slate-400`;
                    if (ping) {
                        ping.className = `hidden`;
                    }
                    txt.textContent = 'Fechado';
                    if (!isMob) {
                        indicator.classList.remove('border-green-600', 'text-green-600');
                        indicator.classList.add('border-principal', 'text-principal');
                    }
                }
            };

            setIndicator(headerIndicator, false);
            setIndicator(mobileIndicator, true);
        };

        if ((window as any).statusInterval) {
            clearInterval((window as any).statusInterval);
        }

        updateStatus();
        (window as any).statusInterval = setInterval(updateStatus, 60000);

        // ==========================================
        // MOBILE OVERLAY MENU CONTROLLER
        // ==========================================
        const menuBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('mobile-menu-close-btn');
        const overlay = document.getElementById('mobile-menu-overlay');

        if (menuBtn && closeBtn && overlay) {
            const openOverlay = (e: Event) => {
                e.stopPropagation();
                overlay.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            };

            const closeOverlay = (e: Event) => {
                e.stopPropagation();
                overlay.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            };

            // Fast responsive pointerdown events
            menuBtn.addEventListener('pointerdown', openOverlay);
            closeBtn.addEventListener('pointerdown', closeOverlay);

            // Accessiblity click fallbacks
            menuBtn.addEventListener('click', (e) => {
                if (e.clientX !== 0 && e.clientY !== 0) {
                    e.preventDefault();
                    return;
                }
                openOverlay(e);
            });
            closeBtn.addEventListener('click', (e) => {
                if (e.clientX !== 0 && e.clientY !== 0) {
                    e.preventDefault();
                    return;
                }
                closeOverlay(e);
            });

            // Keyboard Escape close support
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
                    overlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                }
            });
        }
    });

    // Reset overlay and scroll lock on navigation preparation
    document.addEventListener('astro:before-preparation', () => {
        const overlay = document.getElementById('mobile-menu-overlay');
        if (overlay) {
            overlay.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }
    });
</script>

<style>
    /* Força o botão de WhatsApp do header a usar a variável de cor base correta em Dark Mode */
    :global(html.dark) .wpp-header-btn {
        color: var(--dark-base-black) !important;
    }

    /* CSS Customizado para o Menu Mobile Overlay */
    #mobile-menu-overlay {
        background-color: var(--color-principal); /* Roxo no Light */
        border: 4px solid var(--color-foreground);
    }
    
    #mobile-menu-overlay nav a {
        color: #ffffff;
        transition: all 0.3s ease;
    }
    
    #mobile-menu-overlay nav a:hover,
    #mobile-menu-overlay nav a.active {
        color: var(--color-destaque) !important; /* Verde Limão no Light */
    }

    #mobile-menu-close-btn {
        background-color: var(--color-destaque) !important;
        color: var(--color-principal) !important;
        border-color: var(--color-principal) !important;
    }

    .overlay-logo-icon {
        background-color: var(--color-destaque);
    }

    .overlay-logo-text {
        color: var(--color-destaque);
    }

    .indicator-finger {
        color: var(--color-destaque);
    }

    /* MODO ESCURO (Inversão Semântica baseada na Paleta Oficial) */
    :global(html.dark) #mobile-menu-overlay {
        background-color: #121212 !important; /* Preto puro do site */
        border-color: var(--color-principal) !important; /* Verde Limão */
    }

    :global(html.dark) #mobile-menu-overlay nav a:hover,
    :global(html.dark) #mobile-menu-overlay nav a.active {
        color: var(--color-principal) !important; /* Verde Limão no Dark */
    }

    :global(html.dark) #mobile-menu-close-btn {
        background-color: var(--color-destaque) !important; /* Roxo no Dark */
        color: var(--color-principal) !important; /* Verde Limão no Dark */
        border-color: var(--color-principal) !important; /* Verde Limão no Dark */
    }

    :global(html.dark) .overlay-logo-icon {
        background-color: var(--color-principal); /* Verde Limão no Dark */
    }

    :global(html.dark) .overlay-logo-text {
        color: var(--color-principal); /* Verde Limão no Dark */
    }

    :global(html.dark) .indicator-finger {
        color: var(--color-principal); /* Verde Limão no Dark */
    }
</style>
