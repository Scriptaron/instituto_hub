---
// Testimonials Carousel Component
---

<section class="flex flex-col gap-4 sm:gap-6 relative animate-slide-up delay-200 mt-12 sm:mt-16 overflow-hidden pl-4 lg:pl-0">
    <div class="flex flex-col md:flex-row md:items-end justify-between pr-4 lg:pr-0 gap-4">
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-black text-principal uppercase leading-[0.9] border-b-4 border-principal inline-block w-max pb-2">
            O Que Dizem<br/><span class="text-destaque" style="-webkit-text-stroke: 2px var(--color-principal);">Na Comunidade</span>
        </h2>
    </div>
    
    <div class="relative w-full group/carousel">
        
        <button id="btn-scroll-left" aria-label="Rolar carrossel para a esquerda" class="absolute left-0 top-1/2 -translate-y-1/2 -mt-4 bg-destaque text-principal border-4 border-principal p-2 neo-shadow hidden md:flex items-center justify-center cursor-pointer hover:bg-destaque transition-all z-20 ml-2 md:ml-4 opacity-0 group-hover/carousel:opacity-100 disabled:opacity-50 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal active:translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>

        
        <button id="btn-scroll-right" aria-label="Rolar carrossel para a direita" class="absolute right-0 top-1/2 -translate-y-1/2 -mt-4 bg-destaque text-principal border-4 border-principal p-2 neo-shadow hidden md:flex items-center justify-center cursor-pointer hover:bg-destaque transition-all animate-pulse hover:animate-none z-20 mr-2 md:mr-4 opacity-100 disabled:opacity-50 group-hover/carousel:animate-none rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal active:translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        
        <div id="carousel-alunos" class="carousel carousel-center max-w-full space-x-4 sm:space-x-6 bg-transparent py-4 sm:py-8 overflow-x-auto pb-8 sm:pb-12 hide-scrollbar scroll-smooth">
        
        
        <div class="carousel-item w-[85vw] sm:w-72 md:w-96 snap-start" data-index="0">
            <div class="bg-destaque border-4 border-principal p-5 sm:p-6 md:p-8 neo-shadow relative rotate-1 hover:rotate-0 transition-transform w-full h-full flex flex-col justify-between rounded-2xl">
                <div class="absolute -top-4 -left-4 text-5xl sm:text-6xl text-white font-black opacity-50 z-0">"</div>
                <p class="text-xl font-bold text-principal relative z-10 font-heading mb-6">
                    O Instituto transformou completamente minha visão sobre o evangelho e me deu amigos eternos.
                </p>
                <div class="flex items-center gap-4 relative z-10 border-t-4 border-principal pt-4 mt-auto">
                    <div class="w-10 h-10 bg-white border-4 border-principal rounded-full flex items-center justify-center text-sm">👤</div>
                    <div>
                        <p class="font-black text-principal uppercase tracking-wider text-sm">João Silva</p>
                        <p class="text-xs font-bold text-slate-800 uppercase">Aluno</p>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="carousel-item w-[85vw] sm:w-72 md:w-96 snap-start" data-index="1">
            <div class="bg-white border-4 border-principal p-5 sm:p-6 md:p-8 neo-shadow relative -rotate-1 hover:rotate-0 transition-transform w-full h-full flex flex-col justify-between rounded-2xl">
                <div class="absolute -top-4 -left-4 text-5xl sm:text-6xl text-destaque font-black opacity-50 z-0">"</div>
                <p class="text-xl font-bold text-principal relative z-10 font-heading mb-6">
                    Ver o progresso espiritual dos jovens adultos a cada semestre é nossa maior recompensa.
                </p>
                <div class="flex items-center gap-4 relative z-10 border-t-4 border-principal pt-4 mt-auto">
                    <div class="w-10 h-10 bg-destaque border-4 border-principal rounded-full flex items-center justify-center text-sm">👤</div>
                    <div>
                        <p class="font-black text-principal uppercase tracking-wider text-sm">Ir. Ribeiro</p>
                        <p class="text-xs font-bold text-slate-800 uppercase">Professor</p>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="carousel-item w-[85vw] sm:w-72 md:w-96 snap-start" data-index="2">
            <div class="bg-principal border-4 border-principal p-5 sm:p-6 md:p-8 neo-shadow relative rotate-2 hover:rotate-0 transition-transform w-full h-full flex flex-col justify-between text-white rounded-2xl">
                <div class="absolute -top-4 -left-4 text-5xl sm:text-6xl text-destaque font-black opacity-50 z-0">"</div>
                <p class="text-xl font-bold relative z-10 font-heading mb-6">
                    As aulas me ajudaram a entender doutrinas difíceis de forma prática para minha vida.
                </p>
                <div class="flex items-center gap-4 relative z-10 border-t-4 border-destaque pt-4 mt-auto">
                    <div class="w-10 h-10 bg-white border-4 border-destaque rounded-full flex items-center justify-center text-sm text-principal">👤</div>
                    <div>
                        <p class="font-black text-destaque uppercase tracking-wider text-sm">Maria Clara</p>
                        <p class="text-xs font-bold text-blue-200 uppercase">Aluna</p>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="carousel-item w-[85vw] sm:w-72 md:w-96 mr-4 sm:mr-8 snap-start" data-index="3">
            <div class="bg-slate-100 border-4 border-principal p-5 sm:p-6 md:p-8 neo-shadow relative -rotate-2 hover:rotate-0 transition-transform w-full h-full flex flex-col justify-between rounded-2xl">
                <div class="absolute -top-4 -left-4 text-5xl sm:text-6xl text-principal font-black opacity-10 z-0">"</div>
                <p class="text-xl font-bold text-principal relative z-10 font-heading mb-6">
                    Encontrei pessoas incríveis que compartilham os mesmos valores que eu. Um refúgio!
                </p>
                <div class="flex items-center gap-4 relative z-10 border-t-4 border-principal pt-4 mt-auto">
                    <div class="w-10 h-10 bg-destaque border-4 border-principal rounded-full flex items-center justify-center text-sm">👤</div>
                    <div>
                        <p class="font-black text-principal uppercase tracking-wider text-sm">Pedro L.</p>
                        <p class="text-xs font-bold text-slate-800 uppercase">Aluno</p>
                    </div>
                </div>
        </div>
        </div>
        
        </div>

        
        <div class="flex md:hidden justify-center flex-wrap gap-3 w-full mt-4 sm:mt-6">
            <button class="carousel-dot w-4 h-4 rounded-full border-2 border-principal bg-principal transition-all duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal" data-target="0" aria-label="Ir para slide 1"></button>
            <button class="carousel-dot w-4 h-4 rounded-full border-2 border-principal bg-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal" data-target="1" aria-label="Ir para slide 2"></button>
            <button class="carousel-dot w-4 h-4 rounded-full border-2 border-principal bg-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal" data-target="2" aria-label="Ir para slide 3"></button>
            <button class="carousel-dot w-4 h-4 rounded-full border-2 border-principal bg-white transition-all duration-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-principal" data-target="3" aria-label="Ir para slide 4"></button>
        </div>

    </div>
</section>

<script>
    // Carousel interactive scroll logic with IntersectionObserver (better performance and A11y)
    document.addEventListener('astro:page-load', () => {
        const carousel = document.getElementById('carousel-alunos');
        const btnLeft = document.getElementById('btn-scroll-left');
        const btnRight = document.getElementById('btn-scroll-right');

        if (carousel && btnLeft && btnRight) {
            const scrollAmount = 350;

            btnLeft.addEventListener('click', () => {
                carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });

            btnRight.addEventListener('click', () => {
                carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });
            
            const dots = document.querySelectorAll('.carousel-dot');
            const items = document.querySelectorAll('#carousel-alunos .carousel-item');
            
            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => {
                    items[idx]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                });
            });

            // Intersection Observer to update dots and buttons state
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const idx = parseInt(entry.target.getAttribute('data-index') || '0');
                        dots.forEach((d, i) => {
                            if(i === idx) {
                                d.classList.remove('bg-white', 'w-4');
                                d.classList.add('bg-principal', 'w-8');
                                d.setAttribute('aria-current', 'true');
                            } else {
                                d.classList.add('bg-white', 'w-4');
                                d.classList.remove('bg-principal', 'w-8');
                                d.setAttribute('aria-current', 'false');
                            }
                        });
                    }
                });
            }, {
                root: carousel,
                threshold: 0.5
            });

            items.forEach(item => observer.observe(item));

            // Update buttons disable state based on scroll position
            carousel.addEventListener('scroll', () => {
                const maxScroll = carousel.scrollWidth - carousel.clientWidth;
                if (carousel.scrollLeft <= 5) {
                    btnLeft.setAttribute('disabled', 'true');
                    btnLeft.setAttribute('aria-disabled', 'true');
                } else {
                    btnLeft.removeAttribute('disabled');
                    btnLeft.setAttribute('aria-disabled', 'false');
                }
                
                if (carousel.scrollLeft >= maxScroll - 5) {
                    btnRight.setAttribute('disabled', 'true');
                    btnRight.setAttribute('aria-disabled', 'true');
                } else {
                    btnRight.removeAttribute('disabled');
                    btnRight.setAttribute('aria-disabled', 'false');
                }
            }, { passive: true });
        }
    });
</script>
